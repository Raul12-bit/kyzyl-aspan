# ---------------- Frontend (Vite, exposed to the browser: never put secrets here) ----------------
# Which DataSource the app uses: "mock" (default, reads public/data/*.json) or "http".
VITE_DATA_SOURCE=mock

# Base URL of the future Kyzyl Aspan data API (used only when VITE_DATA_SOURCE=http).
# VITE_API_URL=https://api.example.org/kyzyl-aspan/v1

# Basemap style (MapLibre style JSON, no token). Default: CARTO Dark Matter.
# VITE_BASEMAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json

# ---------------- Backend (pnpm server — read by server/config.ts, never sent to the browser) ----------------
# Google AI Studio key for the AI risk analysis. Without it the API returns rule-based findings.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TIMEOUT_MS=20000
# PORT=8787
# HOST=127.0.0.1
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# AI_RATE_LIMIT_PER_MIN=10
# SERVE_STATIC=1
