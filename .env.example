# ---------------- Frontend (Vite, exposed to the browser: never put secrets here) ----------------
# Which DataSource the app uses:
#   "auto" (default) — the real HELIOS-SHIELD API if it answers at start-up, otherwise the static demo;
#   "http"           — always the real API;
#   "mock"           — always the demo (public/data/*.json). `?mock` in the page URL forces the demo too.
VITE_DATA_SOURCE=auto

# Base URL of the data API. Default "/v1": same origin — the Vite dev server and `pnpm server`
# proxy /v1/* to the HELIOS API (see HELIOS_API_ORIGIN / HELIOS_API_URL below), so no CORS is needed.
# VITE_API_URL=/v1

# Basemap style (MapLibre style JSON, no token). Default: CARTO Dark Matter.
# VITE_BASEMAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json

# ---------------- Dev server (vite.config.ts) ----------------
# Where `pnpm dev` proxies /v1/* (origin only, no path). Default: the local HELIOS API.
# HELIOS_API_ORIGIN=http://127.0.0.1:8000

# ---------------- Backend (pnpm server — read by server/config.ts, never sent to the browser) ----------------
# Google AI Studio key for the AI risk analysis. Without it the API returns rule-based findings.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TIMEOUT_MS=20000
# PORT=8787
# HOST=127.0.0.1
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# AI_RATE_LIMIT_PER_MIN=10
# AI #3 ground forecast (POST /api/ai/ground/forecast), requests per minute per IP:
# AI_GROUND_RATE_LIMIT_PER_MIN=60
# SERVE_STATIC=1
# HELIOS API (with /v1): `pnpm server` proxies /v1/* there and gives AI briefs its forecast as context.
# HELIOS_API_URL=http://127.0.0.1:8000/v1
# HELIOS_TIMEOUT_MS=4000
