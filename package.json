{
  "name": "kyzyl-aspan",
  "private": true,
  "version": "0.1.0",
  "description": "Kyzyl Aspan — 26 years of MODIS and VIIRS fire detections on one comparable H3 scale (NASA Space Apps Challenge 2026).",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:mock": "tsx scripts/generate-mock-data.ts",
    "server": "tsx server/index.ts",
    "server:watch": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "data:geo": "tsx scripts/generate-geo-data.ts",
    "models:build": "node scripts/build-satellite-models.mjs"
  },
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@tanstack/react-query": "^5.107.1",
    "h3-js": "4.5.0",
    "maplibre-gl": "5.24.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "three": "0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/vite": "4.3.5",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/three": "0.187.0",
    "@types/topojson-client": "3.1.5",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "16.5.0",
    "prettier": "^3.10.1",
    "tailwindcss": "4.3.5",
    "topojson-client": "3.1.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "7.3.8",
    "vitest": "3.2.7",
    "world-atlas": "2.0.2",
    "world-countries": "5.1.0"
  }
}
